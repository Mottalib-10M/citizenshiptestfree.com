---
/** Embeddable tool (iframe): no navigation, noindex, out of the sitemap (astro.config).
 *  Remplace le 2026-10-25 les embeds britanniques et canadien, devenus des renvois (data/renvois.ts). */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import LicenceNotice from '../../components/LicenceNotice.astro';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>U.S. civics practice test (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${route('us-test', 'en')}`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <Tool tool={{ kind: 'usquiz', props: { version: '2025', mode: 'exam', versionSelect: true } }} lang="en" primary={true} seedKey="embed-us-civics-test" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}${route('us-test', 'en')}`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a></p>
    <LicenceNotice lang="en" class="mt-2 text-center text-[11px] text-navy-600" />
  </body>
</html>
