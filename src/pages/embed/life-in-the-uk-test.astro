---
/** Embeddable tool (iframe): no navigation, noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Life in the UK practice test (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${route('uk-test', 'en')}`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <Tool tool={{ kind: 'quiz', props: { country: 'uk', mode: 'exam' } }} lang="en" primary={true} seedKey="embed-life-in-the-uk-test" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}${route('uk-test', 'en')}`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a></p>
  </body>
</html>
