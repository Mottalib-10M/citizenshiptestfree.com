---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
// Un seul embed depuis le 2026-10-25 : le test cívico américain. Les anciens embeds britanniques et
// canadien sont des renvois vers les sites de ces pays (data/renvois.ts).
const code = `<iframe src="${SITE_URL}/embed/us-civics-test/" title="U.S. civics practice test" width="100%" height="820" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free U.S. civics practice test on your website" description="Put the free U.S. civics mock interview on your website: one iframe, the official USCIS questions, the officer's stop rule, no sign-up, no tracking and no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the U.S. civics practice test</h1>
    <p class="mt-3 text-lg text-navy-700">For a library, an adult school, a citizenship class or a community group that helps green card holders.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Civics mock interview, 2025 and 2008 lists</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the frame visible and use it as it is, without warranty. When USCIS changes an answer, the embedded test updates itself. Nothing your visitors answer reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/us-civics-test/" title="U.S. civics practice test" width="100%" height="820" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
