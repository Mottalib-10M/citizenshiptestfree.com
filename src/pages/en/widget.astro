---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/life-in-the-uk-test/" title="Life in the UK practice test" width="100%" height="820" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/british-citizenship-date/" title="When can I apply for British citizenship" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free Life in the UK mock test on your website" description="Put the free Life in the UK mock test or the British citizenship date calculator on your website: one iframe, explained answers, no sign-up, no tracking and no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a test or the date calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For a library, a college, a council or a community group that helps new residents.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Life in the UK mock test</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>British citizenship date calculator</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p>Conditions: keep the credit line under the frame visible and use it as it is, without warranty. When a fee or a rule changes, the embedded tool updates itself. Nothing your visitors answer reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/life-in-the-uk-test/" title="Life in the UK practice test" width="100%" height="820" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
