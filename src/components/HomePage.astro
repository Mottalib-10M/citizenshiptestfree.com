---
/**
 * Home of the English version: the U.S. civics test first (the heart of the site), the two versions,
 * the N-400 date and fee, the residence rules, then every U.S. page. Every figure is read from params.
 * Les sections Royaume-Uni, Australie et Canada et la version française (accueil canadien) ont été
 * retirées le 2026-10-25 : ces pays ont désormais chacun leur site, et la home espagnole est HomeEs.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Tool from './Tool.astro';
import Clamp from './Clamp.astro';
import Sources from './Sources.astro';
import { route, type Locale } from '../i18n/routes';
import { PAGES } from '../lib/guides';
import { helpers } from '../lib/helpers';
import { LAST_UPDATED, AUTHOR_NAME } from '../data/site-config';
import { displayDate } from '../lib/format';
import { faqSchema, webApplicationSchema, websiteSchema, organizationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const h = helpers(lang, true);
const P = h.P;
const U = P.us;
const N = U.n400;

const title = 'Citizenship Test 2026: Free USCIS Civics Practice in English';
const description = 'Free U.S. citizenship test practice with the official USCIS civics questions, the real stop rule at 12 right, English practice, the N-400 date and the fee.';
const faqs = [

  { q: 'How long does it take to get ready for the civics test?', a: `Most applicants who read English comfortably need three to four weeks of short daily sessions. The 2025 list has ${h.us.n25} questions, but they circle around the same documents, institutions and wars, so the answers come back again and again. Start with the themes you know least, then take full mock interviews until you reach ${U.test2025.passCorrect} right several times in a row.` },
  { q: 'Are these the real questions the officer will ask?', a: `Yes for the United States: USCIS publishes the whole list, and every question and accepted answer here is copied from it without change. The officer picks up to ${U.test2025.asked} of them aloud. Only the answer choices and the order are ours. The Spanish translation of the 2025 list is ours too; the 2008 list uses the official USCIS translation.` },
  { q: 'Do I have to pay for a citizenship test?', a: `No. The English and civics tests are included in the N-400 fee, ${h.usd(U.fees.online)} online or ${h.usd(U.fees.paper)} on paper, biometrics included, and there is no separate booking. Households under ${U.fees.reducedMaxPctFpg}% of the federal poverty guidelines pay ${h.usd(U.fees.reduced)} on paper. These practice tests are free.` },
  { q: 'When can I sit the test?', a: `You cannot book it. You file Form N-400 first, up to ${U.n400.earlyFilingDays} days before your fifth or third green card anniversary, and USCIS then schedules the interview where both tests take place, usually several months later. That is why the first filing date matters most: every day you file late is a day added before the interview.` },
  { q: 'How many days abroad can I have before applying?', a: `There is no fixed total, but two rules apply. A single trip of more than six months may break continuous residence and one of a year or more breaks it. And you need ${h.num(N.routes['5'].presenceDays)} days inside the United States over five years, or ${h.num(N.routes['3'].presenceDays)} over three on the spouse route, so about ${h.num(5 * 365 - N.routes['5'].presenceDays)} days abroad in total is the most the five-year route allows.` },
  { q: 'Can I take the U.S. civics test in another language?', a: `Only with an age exemption. Applicants aged ${U.englishExempt[0].age} or older with ${U.englishExempt[0].years} years as permanent residents, or ${U.englishExempt[1].age} with ${U.englishExempt[1].years}, skip the English test and may take civics in their own language with an interpreter they bring. Everyone else answers in English. The Spanish pages of this site show each question in Spanish and in English, to understand it first and then memorize it.` },
];
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webApplicationSchema({ name: 'Citizenship practice tests built on the official USCIS questions', description, path: route('home', lang), lang }), faqSchema(faqs, lang)];
const resumeEn = `The U.S. citizenship test takes place at the naturalization interview, face to face with a USCIS officer, and has two parts: English (read one sentence aloud, write one from dictation, answer questions about your application) and civics, on American history and government. Every Form N-400 received on or after ${h.date(U.cutoff)} leads to the 2025 civics test: the officer asks up to ${U.test2025.asked} questions aloud from a public list of ${h.us.n25}, and you need ${U.test2025.passCorrect} right answers. The officer stops as soon as you reach ${U.test2025.passCorrect} right or ${U.test2025.failWrong} wrong. An N-400 received earlier keeps the 2008 test: up to ${U.test2008.asked} of ${h.us.n08} questions, ${U.test2008.passCorrect} to pass. Applicants aged ${U.s6520.age} or older with ${U.s6520.years} years as permanent residents study only 20 questions. The mock interview above draws from the official list, accepts every answer USCIS lists and stops exactly where the officer would. Below it: the two versions side by side, the first day you can file Form N-400 and what it costs.`;
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} faqs={faqs} breadcrumbs={[]}>
  <header class="mb-3">
    <h1 class="mt-0 text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">Citizenship test practice with the official USCIS questions</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{`Up to ${U.test2025.asked} official civics questions, ${U.test2025.passCorrect} right to pass, the officer’s stop rule. No sign-up.`}</p>
  </header>
  <div data-outil class="mb-4"><Tool tool={{ kind: 'usquiz', props: { version: '2025', mode: 'exam', versionSelect: true } }} lang={lang} primary={true} seedKey="home" /></div>
  <Clamp text={resumeEn} id="clamp-home" lang={lang} class="mb-3" />
  <p class="mb-8 text-sm text-navy-600">Updated <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, 'en-GB')}</time> · {AUTHOR_NAME} · <a href={route('method', lang)} class="underline hover:text-navy-900">How the questions and dates are built</a> · <a href={route('about', lang)} class="underline hover:text-navy-900">About this site</a></p>

  <div class="prose prose-slate max-w-none">
    <h2>The two versions of the U.S. civics test</h2>
    <Fragment set:html={h.table(['Rule', '2025 version', '2008 version'], [['Who takes it', `N-400 received on or after ${h.date(U.cutoff)}`, 'N-400 received before'], ['Official list', `${h.us.n25} questions`, `${h.us.n08} questions`], ['Asked at the interview', `up to ${U.test2025.asked}`, `up to ${U.test2008.asked}`], ['Right answers to pass', U.test2025.passCorrect, U.test2008.passCorrect], ['The officer stops at', `${U.test2025.passCorrect} right or ${U.test2025.failWrong} wrong`, `${U.test2008.passCorrect} right or ${U.test2008.failWrong} wrong`], ['Aged 65+ with 20 years as LPR', '10 of 20 starred questions, 6 to pass', '10 of 20 starred questions, 6 to pass']], `Rules read on uscis.gov on ${h.date(U.retrieved_at)}.`, ['l', 'l', 'l'])} />
    <p>Which version you take depends only on the date USCIS received your N-400, printed on the receipt notice. The <a href={route('us-which', lang)}>version checker</a> also tells you whether an age exemption lets you skip the English test or take civics in your own language.</p>
    <h2>Before the test: the N-400 filing date</h2>
    <p>You cannot book the U.S. test. You file Form N-400 first, up to {N.earlyFilingDays} days before the fifth anniversary of your green card, or the third if you have been married to and living with a U.S. citizen, with at least {h.num(N.routes['5'].presenceDays)} days of physical presence over five years. The mini tool below counts the days you still need; the <a href={route('us-n400', lang)}>N-400 date calculator</a> finds the exact first day with your trips.</p>
  </div>
  <div class="mb-6"><Tool tool={{ kind: 'mini:uspresence' }} lang={lang} idPrefix="h1" /></div>
  <div class="prose prose-slate max-w-none">
    <h2>Every U.S. practice page</h2>
  </div>
  <div class="not-prose grid gap-6 md:grid-cols-2" data-sommaire>
    <section><h3 class="mb-2 text-lg font-semibold text-navy-900">The test</h3><ul class="space-y-2 text-sm">{PAGES.filter((p) => p.order < 90).map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline">{p.en.nav}</a><span class="block text-navy-700">{p.en.card}</span></li>)}</ul></section>
    <section><h3 class="mb-2 text-lg font-semibold text-navy-900">Form N-400</h3><ul class="space-y-2 text-sm">{PAGES.filter((p) => p.order >= 90).map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline">{p.en.nav}</a><span class="block text-navy-700">{p.en.card}</span></li>)}</ul></section>
  </div>
  <div class="prose prose-slate mt-8 max-w-none">
    <h2>What the N-400 costs</h2>
    <p>The N-400 fee covers both tests and biometrics: {h.usd(U.fees.online)} online and {h.usd(U.fees.paper)} on paper per applicant. Households under {U.fees.reducedMaxPctFpg}% of the federal poverty guidelines pay {h.usd(U.fees.reduced)}, and at or below {U.fees.waiverMaxPctFpg}% they can ask for a waiver with Form I-912; both require a paper filing.</p>
  </div>
  <div class="mb-6"><Tool tool={{ kind: 'mini:usfee' }} lang={lang} idPrefix="h2" /></div>
  <div class="prose prose-slate max-w-none">
    <h2>The test is the easy part: the date is the hard one</h2>
    <p>Most applicants who wait longer than they need to do not fail the test. They file too early and see the N-400 denied, because a long trip sits in the wrong window, or they wait months after the day they could have filed. Three residence rules decide the first day, and the official early filing calculator on uscis.gov looks at only one of them.</p>
    <p><strong>Continuous residence.</strong> Five years as a permanent resident, or three on the spouse route, without a break. A trip of more than {N.absencePresumptionDays} days but less than a year creates a presumption that residence was broken, which you can rebut with proof that you kept your job, your home and your tax filings. A trip of {N.absenceBreakDays} days or more breaks it, and the clock restarts: you can file again {N.afterBreakWait['5']} after your return on the five-year route.</p>
    <p><strong>Physical presence.</strong> At least {h.num(N.routes['5'].presenceDays)} days inside the United States in the five years ({N.routes['5'].presenceMonths} months), or {h.num(N.routes['3'].presenceDays)} in three years on the spouse route. The day you leave and the day you come back both count as days present, so a weekend trip costs only the days in between.</p>
    <p><strong>State or district.</strong> {N.stateMonths} months living in the state or USCIS district where you file, counted back from the filing date. A move just before you file can push the date back even when the other two rules are met.</p>
    <h2>What the tools here do not judge</h2>
    <p>The date tool looks at time and travel only. Good moral character over the statutory period, tax filing, Selective Service registration for men who lived in the United States between 18 and 26, child support, and any arrest or immigration problem are decided case by case by the officer. A date given here means the residence rules are met on that day under the published rule, nothing more. When a result falls within a few days of a limit, the tool says so: check the dates against your passport stamps or your official travel history before you file.</p>
    <h2>How the questions are written</h2>
    <p>The U.S. civics questions and answers are the official USCIS lists, in the public domain, copied without change; only the answer choices and the English practice sentences are ours. Answers that depend on who holds an office today come from the USCIS test updates page, and questions whose answer depends on where you live are shown but never scored. The <a href={route('method', lang)}>method page</a> explains how a test is drawn and how the stop rule is applied.</p>
    <Sources lang={lang} keys={['us_study', 'us_128', 'us_100', 'us_updates', 'us_n400', 'us_reduced', 'us_pm_d3', 'us_pm_d4']} />
  </div>
</PageLayout>
